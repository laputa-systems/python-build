#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
LANE_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
REPO_ROOT=$(cd -- "$LANE_DIR/.." && pwd)
RESULTS=${P0_BENCH_RESULTS:-$LANE_DIR/results/perf-bench}
PERF_PY=${PERF_PY:-$LANE_DIR/perf.py}
GATE_READY=${PERF_GATE_READY:-$SCRIPT_DIR/perf-gate-ready}

MODE=default
DIAGNOSTIC_REASON=
if [[ ${1:-} == --diagnostic-reason ]]; then
    MODE=diagnostic
    if (($# >= 2)); then
        DIAGNOSTIC_REASON=$2
        shift 2
    else
        shift
    fi
    if [[ -z "${DIAGNOSTIC_REASON//[[:space:]]/}" ]]; then
        printf '%s\n' 'ERROR: --diagnostic-reason requires non-empty text' >&2
        exit 2
    fi
fi
BENCH_ARGS=("$@")

if [[ "$RESULTS" != /* ]]; then
    RESULTS=$PWD/$RESULTS
fi
if [[ "$PERF_PY" != /* ]]; then
    PERF_PY=$PWD/$PERF_PY
fi
if [[ "$GATE_READY" != /* ]]; then
    GATE_READY=$PWD/$GATE_READY
fi

mkdir -p "$RESULTS"
start_stamp=$(date -u +%Y%m%dT%H%M%S%NZ)
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
find "$RESULTS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort > "$tmpdir/before-dirs"

if "$GATE_READY" > "$tmpdir/pre.out" 2>&1; then
    pre_exit=0
else
    pre_exit=$?
fi
pre_utc=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)

if ((pre_exit != 0)) && [[ "$MODE" == default ]]; then
    record_path=$RESULTS/external-host-checks-$start_stamp.json
    python3 - "$record_path" "$tmpdir/pre.out" "$pre_exit" "$pre_utc" \
        "${BENCH_ARGS[@]}" <<'PY'
import json
import sys
from pathlib import Path

record_path, pre_path, pre_exit, pre_utc, *args = sys.argv[1:]
record = {
    "pre": {
        "exit": int(pre_exit),
        "output": Path(pre_path).read_text(encoding="utf-8", errors="replace"),
        "utc": pre_utc,
    },
    "mode": "default",
    "bench_run": False,
    "status": "DEFERRED",
    "eligible": False,
    "accepted": False,
    "args": args,
}
Path(record_path).write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
    printf 'DEFERRED: perf-gate-ready precheck exit=%d; bench not run\n' "$pre_exit" >&2
    exit 4
fi

set +e
(
    cd -- "$REPO_ROOT"
    python3 "$PERF_PY" bench "${BENCH_ARGS[@]}"
) 2>&1 | tee "$tmpdir/bench.log"
pipeline_status=("${PIPESTATUS[@]}")
set -e
bench_exit=${pipeline_status[0]}

if "$GATE_READY" -1 > "$tmpdir/post.out" 2>&1; then
    post_exit=0
else
    post_exit=$?
fi
post_utc=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)

result_dir=
reported_dir=$(sed -nE 's/^LOG[[:space:]]+(.+)\/verdict\.json$/\1/p' "$tmpdir/bench.log" | tail -n 1)
if [[ -n "$reported_dir" ]]; then
    if [[ "$reported_dir" != /* ]]; then
        reported_dir=$REPO_ROOT/$reported_dir
    fi
    reported_dir=$(realpath -m -- "$reported_dir")
    if [[ "$reported_dir" == "$RESULTS/"* && -d "$reported_dir" ]] \
            && ! grep -Fqx -- "${reported_dir##*/}" "$tmpdir/before-dirs"; then
        result_dir=$reported_dir
    fi
fi

if [[ -z "$result_dir" ]]; then
    mapfile -t after_dirs < <(find "$RESULTS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
    new_dirs=()
    for dir in "${after_dirs[@]}"; do
        if ! grep -Fqx -- "$dir" "$tmpdir/before-dirs"; then
            new_dirs+=("$dir")
        fi
    done
    if ((${#new_dirs[@]})); then
        result_dir=$RESULTS/$(printf '%s\n' "${new_dirs[@]}" | sort | tail -n 1)
    fi
fi

if [[ -n "$result_dir" ]]; then
    record_path=$result_dir/external-host-checks.json
    log_path=$result_dir/p0-bench.log
else
    record_path=$RESULTS/external-host-checks-$start_stamp.json
    log_path=$RESULTS/p0-bench-$start_stamp.log
fi
mv -- "$tmpdir/bench.log" "$log_path"

verdict_path=
if [[ -n "$result_dir" ]]; then
    verdict_path=$result_dir/verdict.json
fi
python3 - "$record_path" "$tmpdir/pre.out" "$pre_exit" "$pre_utc" \
    "$tmpdir/post.out" "$post_exit" "$post_utc" "$bench_exit" "$MODE" \
    "$DIAGNOSTIC_REASON" "$verdict_path" "${BENCH_ARGS[@]}" <<'PY'
import json
import sys
from pathlib import Path

(
    record_path,
    pre_path,
    pre_exit,
    pre_utc,
    post_path,
    post_exit,
    post_utc,
    bench_exit,
    mode,
    diagnostic_reason,
    verdict_path,
    *args,
) = sys.argv[1:]
pre_exit = int(pre_exit)
post_exit = int(post_exit)
bench_exit = int(bench_exit)
raw_verdict = None
if verdict_path:
    try:
        verdict_file = json.loads(Path(verdict_path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        verdict_file = None
    if isinstance(verdict_file, dict) and isinstance(verdict_file.get("verdict"), str):
        raw_verdict = verdict_file["verdict"]
    elif (
        isinstance(verdict_file, dict)
        and isinstance(verdict_file.get("decision"), dict)
        and isinstance(verdict_file["decision"].get("decision"), str)
    ):
        raw_verdict = verdict_file["decision"]["decision"]
    elif isinstance(verdict_file, dict) and isinstance(verdict_file.get("decision"), str):
        raw_verdict = verdict_file["decision"]
    elif isinstance(verdict_file, dict):
        raw_verdict = verdict_file.get("decision", verdict_file)
    else:
        raw_verdict = verdict_file
if not isinstance(raw_verdict, str):
    print(
        "p0-bench: verdict.json has no verdict string; storing raw value",
        file=sys.stderr,
    )
eligible = mode == "default" and pre_exit == 0 and post_exit == 0 and bench_exit == 0
record = {
    "pre": {
        "exit": pre_exit,
        "output": Path(pre_path).read_text(encoding="utf-8", errors="replace"),
        "utc": pre_utc,
    },
    "post": {
        "exit": post_exit,
        "output": Path(post_path).read_text(encoding="utf-8", errors="replace"),
        "utc": post_utc,
    },
    "bench_exit": bench_exit,
    "mode": mode,
    "verdict": raw_verdict,
    "bench_run": True,
    "eligible": eligible,
    "accepted": eligible and raw_verdict == "ACCEPT",
    "args": args,
}
if mode == "diagnostic":
    record["diagnostic_reason"] = diagnostic_reason
Path(record_path).write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY

printf 'p0-bench evidence: %s\n' "$record_path" >&2
printf 'p0-bench log: %s\n' "$log_path" >&2

if ((bench_exit != 0)); then
    exit "$bench_exit"
fi
if ((pre_exit != 0 || post_exit != 0)) || [[ "$MODE" == diagnostic ]]; then
    printf 'NOT ELIGIBLE: perf-gate-ready pre exit=%d, post exit=%d\n' \
        "$pre_exit" "$post_exit" >&2
    exit 3
fi
