#!/usr/bin/env python3
"""Fail-closed quiet-host check for native Linux x86_64 campaign measurements.

Usage: perf-gate-ready [-s PATH] [-1] [--json]. -1 is the post-run check.

This checks host readiness only: architecture, contention, steal time,
swapping, memory, disk and AC power. It does not identify the measured stage:
the pinned image, target, allocator, toolchain, source and binary identities
are verified by perf.py's build reports and stage digests. H0/A/A statistical
qualification is decided by the harness verdicts, not by this gate. The
benchmark's internal quiet-host and paired-sampling gates remain mandatory.
"""
from __future__ import annotations

import argparse
import json
import os
import platform
import shutil
import time
from pathlib import Path

MIN_IDLE_PERCENT = 95.0
MAX_IOWAIT_PERCENT = 2.0
MAX_STEAL_PERCENT = 0.2
MAX_LOAD_PER_CORE = 0.7
MIN_AVAILABLE_GIB = 4.0
MIN_DISK_FREE_GIB = 20.0
GIB = 1024**3


def cpu_counters() -> tuple[int, int, int, int]:
    values = [int(item) for item in Path("/proc/stat").read_text().splitlines()[0].split()[1:]]
    if len(values) < 8:
        raise ValueError("/proc/stat lacks required CPU counters")
    return sum(values), values[3], values[4], values[7]


def swapped_pages() -> int:
    counters = {}
    for line in Path("/proc/vmstat").read_text().splitlines():
        key, _, value = line.partition(" ")
        if key in {"pswpin", "pswpout"}:
            counters[key] = int(value.strip())
    if set(counters) != {"pswpin", "pswpout"}:
        raise ValueError("/proc/vmstat lacks swap counters")
    return sum(counters.values())


def available_memory_gib() -> float:
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) * 1024 / GIB
    raise ValueError("/proc/meminfo lacks MemAvailable")


def ac_online() -> bool | None:
    paths = list(Path("/sys/class/power_supply").glob("*/online"))
    if not paths:
        return None  # Boards without power telemetry are not failed on it.
    readings = [path.read_text().strip() for path in paths]
    if any(value not in {"0", "1"} for value in readings):
        raise ValueError("unknown AC power-supply state")
    return "1" in readings


def sample_cpu(seconds: int = 3) -> dict[str, float | int]:
    start = cpu_counters()
    swap_before = swapped_pages()
    idle_min, iowait_max, steal_max = 100.0, 0.0, 0.0
    for _ in range(seconds):
        time.sleep(1)
        end = cpu_counters()
        total = end[0] - start[0]
        if total <= 0:
            raise ValueError("non-increasing CPU counters")
        idle_min = min(idle_min, 100 * (end[1] - start[1]) / total)
        iowait_max = max(iowait_max, 100 * (end[2] - start[2]) / total)
        steal_max = max(steal_max, 100 * (end[3] - start[3]) / total)
        start = end
    return {"min_idle_pct": idle_min, "max_iowait_pct": iowait_max,
            "max_steal_pct": steal_max, "swap_pages": swapped_pages() - swap_before}


def host_identity() -> dict[str, str]:
    """Record host identity for the receipt; none of it decides quietness."""
    if platform.system() != "Linux" or platform.machine() != "x86_64":
        raise ValueError("requires native Linux x86_64; emulation is out of scope")
    release = {}
    for line in Path("/etc/os-release").read_text().splitlines():
        key, sep, value = line.partition("=")
        if sep:
            release[key] = value.strip().strip('"')
    return {"architecture": platform.machine(), "kernel": platform.release(),
            "os_id": release.get("ID", ""), "os_version_id": release.get("VERSION_ID", ""),
            "os_pretty_name": release.get("PRETTY_NAME", "")}


def classify(metrics: dict[str, object]) -> list[str]:
    failures = []
    for key, threshold, label in (
        ("min_idle_pct", MIN_IDLE_PERCENT, "CPU idle"),
        ("available_gib", MIN_AVAILABLE_GIB, "available memory"),
        ("disk_free_gib", MIN_DISK_FREE_GIB, "disk free"),
    ):
        if float(metrics[key]) < threshold:
            failures.append(f"{label} {metrics[key]} below {threshold}")
    for key, threshold, label in (
        ("max_iowait_pct", MAX_IOWAIT_PERCENT, "CPU iowait"),
        ("max_steal_pct", MAX_STEAL_PERCENT, "CPU steal"),
    ):
        if float(metrics[key]) > threshold:
            failures.append(f"{label} {metrics[key]} exceeds {threshold}")
    if float(metrics["load1"]) > float(metrics["cores"]) * MAX_LOAD_PER_CORE:
        failures.append("1m load exceeds 0.7 per CPU")
    if int(metrics["swap_pages"]) != 0:
        failures.append(f"swap activity detected: {metrics['swap_pages']} pages")
    if metrics["ac_online"] is False:
        failures.append("host is not on AC power")
    return failures


def collect(path: Path) -> tuple[dict[str, object], dict[str, str]]:
    identity = host_identity()
    counters = sample_cpu()
    usage = shutil.disk_usage(path)
    metrics = {**counters, "cores": len(os.sched_getaffinity(0)),
               "load1": os.getloadavg()[0],
               "available_gib": round(available_memory_gib(), 2),
               "disk_free_gib": round(usage.free / GIB, 2),
               "ac_online": ac_online(), "path": str(path.resolve())}
    return metrics, identity


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-s", "--space", default=".", help="filesystem to check for free space")
    parser.add_argument("-1", action="store_true", dest="post", help="post-measurement check")
    parser.add_argument("--json", action="store_true", help="print machine-readable evidence")
    parser.add_argument("--self-test", action="store_true", help="test the decision rules offline")
    args = parser.parse_args(argv)
    if args.self_test:
        healthy = {"min_idle_pct": 99, "available_gib": 10, "disk_free_gib": 70,
                   "max_iowait_pct": 0, "max_steal_pct": 0, "load1": 0,
                   "cores": 8, "swap_pages": 0, "ac_online": None}
        assert classify(healthy) == []
        for changed in ({"min_idle_pct": 80}, {"swap_pages": 1},
                        {"max_steal_pct": 0.3}, {"disk_free_gib": 5},
                        {"ac_online": False}):
            assert classify({**healthy, **changed})
        print("PASS gate decision controls")
        return 0
    metrics, identity = {}, {}
    try:
        metrics, identity = collect(Path(args.space))
        failures = classify(metrics)
    except (OSError, ValueError, ZeroDivisionError) as error:
        failures = [str(error)]
    result = {"phase": "post" if args.post else "pre", "ok": not failures,
              "scope": "host-readiness", "host": identity,
              "metrics": metrics, "failures": failures}
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print(f"{'OK' if result['ok'] else 'BLOCKED'} perf-gate-ready ({result['phase']}): "
              + ("quiet-host controls passed" if not failures else "; ".join(failures)))
        if metrics:
            print(json.dumps(metrics, sort_keys=True))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
